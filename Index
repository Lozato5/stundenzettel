import { useState, useEffect } from "react";

// ── Easter & Holidays ─────────────────────────────────────────────────────────
function easter(Y) {
  const a=Y%19,b=Math.floor(Y/100),c=Y%100,d=Math.floor(b/4),e=b%4,
    f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,
    i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,
    m=Math.floor((a+11*h+22*l)/451),
    mo=Math.floor((h+l-7*m+114)/31),
    dy=((h+l-7*m+114)%31)+1;
  return new Date(Y,mo-1,dy);
}
function addD(d,n){const r=new Date(d);r.setDate(r.getDate()+n);return r;}
function ds(d){return d.toISOString().split("T")[0];}

const BL_LIST=[
  {code:"BW",name:"Baden-Württemberg"},{code:"BY",name:"Bayern"},
  {code:"BE",name:"Berlin"},{code:"BB",name:"Brandenburg"},
  {code:"HB",name:"Bremen"},{code:"HH",name:"Hamburg"},
  {code:"HE",name:"Hessen"},{code:"MV",name:"Mecklenburg-Vorpommern"},
  {code:"NI",name:"Niedersachsen"},{code:"NW",name:"Nordrhein-Westfalen"},
  {code:"RP",name:"Rheinland-Pfalz"},{code:"SL",name:"Saarland"},
  {code:"SN",name:"Sachsen"},{code:"ST",name:"Sachsen-Anhalt"},
  {code:"SH",name:"Schleswig-Holstein"},{code:"TH",name:"Thüringen"},
];

function getHolidays(year, bl) {
  const e=easter(year);
  const h={
    [ds(new Date(year,0,1))]:"Neujahr",
    [ds(addD(e,-2))]:"Karfreitag",
    [ds(addD(e,1))]:"Ostermontag",
    [ds(new Date(year,4,1))]:"Tag der Arbeit",
    [ds(addD(e,39))]:"Christi Himmelfahrt",
    [ds(addD(e,50))]:"Pfingstmontag",
    [ds(new Date(year,9,3))]:"Tag d. Deutschen Einheit",
    [ds(new Date(year,11,25))]:"1. Weihnachtstag",
    [ds(new Date(year,11,26))]:"2. Weihnachtstag",
  };
  if(["BW","BY","ST"].includes(bl)) h[ds(new Date(year,0,6))]="Heilige Drei Könige";
  if(["BW","BY","HE","NW","RP","SL"].includes(bl)) h[ds(addD(e,60))]="Fronleichnam";
  if(["BY","SL"].includes(bl)) h[ds(new Date(year,7,15))]="Mariä Himmelfahrt";
  if(["BB","HB","HH","MV","NI","SN","ST","SH","TH"].includes(bl)) h[ds(new Date(year,9,31))]="Reformationstag";
  if(["BW","BY","NW","RP","SL"].includes(bl)) h[ds(new Date(year,10,1))]="Allerheiligen";
  return h;
}

// ── Time Helpers ──────────────────────────────────────────────────────────────
function parseTime(s){const p=s?.split(":");if(!p||p.length<2)return null;const[h,m]=p.map(Number);return isNaN(h)?null:h*60+m;}
function toHHMM(m){if(m==null)return"—";const h=Math.floor(Math.abs(m)/60),mn=Math.abs(m)%60;return`${String(h).padStart(2,"0")}:${String(mn).padStart(2,"0")}`;}
function calcMins(start,end,pause){
  const s=parseTime(start),e=parseTime(end);
  if(s===null||e===null||e<=s)return null;
  const t=e-s-(Number(pause)||0);
  return t>0?t:0;
}

const MONTHS=["Januar","Februar","März","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
const MINIJOB=556;
let idCtr=1;
function emptyRow(){return{id:idCtr++,date:"",start:"",end:"",pause:"30",note:""};}
function yyyymm(y,m){return`${y}-${String(m+1).padStart(2,"0")}`;}

