export default function Stundenzettel() {
  const now=new Date();
  const [curY,setCurY]=useState(now.getFullYear());
  const [curM,setCurM]=useState(now.getMonth());
  const [profile,setProfile]=useState({name:"",employer:"",bundesland:"NW",hourlyRate:""});
  const [allData,setAllData]=useState({});
  const [theme,setTheme]=useState("dark");
  const [showHelp,setShowHelp]=useState(false);
  const [loaded,setLoaded]=useState(false);

  const key=yyyymm(curY,curM);
  const rows=allData[key]||(allData[key]=[emptyRow(),emptyRow(),emptyRow()],allData[key]);
  const holidays=getHolidays(curY,profile.bundesland);

  // ── Storage Load ──────────────────────────────────────────────────────────
  useEffect(()=>{
    (async()=>{
      try{
        const p=await window.storage.get("stz_profile");
        if(p) setProfile(JSON.parse(p.value));
      }catch{}
      try{
        const d=await window.storage.get("stz_data");
        if(d) setAllData(JSON.parse(d.value));
      }catch{}
      try{
        const t=await window.storage.get("stz_theme");
        if(t) setTheme(t.value);
      }catch{}
      setLoaded(true);
    })();
  },[]);

  useEffect(()=>{
    if(!loaded)return;
    (async()=>{
      try{await window.storage.set("stz_profile",JSON.stringify(profile));}catch{}
      try{await window.storage.set("stz_data",JSON.stringify(allData));}catch{}
      try{await window.storage.set("stz_theme",theme);}catch{}
    })();
  },[profile,allData,theme,loaded]);

  // ── Row helpers ───────────────────────────────────────────────────────────
  function setRows(fn){
    setAllData(prev=>{
      const cur=prev[key]||[emptyRow()];
      const next=typeof fn==="function"?fn(cur):fn;
      return{...prev,[key]:next};
    });
  }
  function updateRow(i,field,val){
    setRows(prev=>{const n=[...prev];n[i]={...n[i],[field]:val};return n;});
  }

  // ── Calculations ──────────────────────────────────────────────────────────
  const totalMins=rows.reduce((acc,r)=>acc+(calcMins(r.start,r.end,r.pause)??0),0);
  const totalHours=totalMins/60;
  const rate=parseFloat(profile.hourlyRate)||0;
  const earnings=rate?totalHours*rate:null;
  const over=earnings!==null&&earnings>MINIJOB;
  const pct=earnings!==null?Math.min((earnings/MINIJOB)*100,100):null;
  const filledRows=rows.filter(r=>r.start&&r.end);

  // ── Navigation ────────────────────────────────────────────────────────────
  function prevM(){if(curM===0){setCurY(y=>y-1);setCurM(11);}else setCurM(m=>m-1);}
  function nextM(){if(curM===11){setCurY(y=>y+1);setCurM(0);}else setCurM(m=>m+1);}

  // ── CSV Export ────────────────────────────────────────────────────────────
  function exportCSV(){
    const header="Datum,Von,Bis,Pause (min),Stunden,Notiz\n";
    const body=rows.map(r=>{
      const m=calcMins(r.start,r.end,r.pause);
      const note=holidays[r.date]||r.note||"";
      return`${r.date},${r.start||""},${r.end||""},${r.pause},${m!==null?toHHMM(m):""},${note}`;
    }).join("\n");
    const blob=new Blob(["\uFEFF"+header+body],{type:"text/csv;charset=utf-8"});
    const a=document.createElement("a");
    a.href=URL.createObjectURL(blob);
    a.download=`Stundenzettel_${MONTHS[curM]}_${curY}.csv`;
    a.click();
  }

  // ── PDF Export ────────────────────────────────────────────────────────────
  function exportPDF(){
    const win=window.open("","_blank","width=820,height=1080");
    if(!win)return;
    const blName=BL_LIST.find(b=>b.code===profile.bundesland)?.name||"";
    const rowsHTML=rows.map(r=>{
      const m=calcMins(r.start,r.end,r.pause);
      const hol=r.date&&holidays[r.date];
      const we=r.date&&[0,6].includes(new Date(r.date).getDay());
      const bg=hol?"#fff8ec":we?"#f8f8f8":"#fff";
      const noteCell=hol?`<span style="color:#c87a20">🔴 ${hol}</span>`:r.note||"";
      return`<tr style="background:${bg}"><td>${r.date||""}</td><td>${r.start||""}</td><td>${r.end||""}</td><td style="text-align:center">${r.pause||0} min</td><td style="font-weight:600;text-align:right">${m!==null?toHHMM(m):"—"}</td><td>${noteCell}</td></tr>`;
    }).join("");
    const earRow=earnings!==null?`<tr><td colspan="4" style="text-align:right;padding-top:6px;color:#555">Stundenlohn: ${rate.toFixed(2).replace(".",",")} €/Std</td><td colspan="2" style="font-weight:700;font-size:15px;text-align:right;padding-top:6px">${earnings.toFixed(2).replace(".",",")} €${over?` <span style="color:red">⚠️ Limit!</span>`:""}</td></tr>`:"";
    win.document.write(`<!DOCTYPE html><html><head><meta charset="utf-8">
    <title>Stundenzettel ${MONTHS[curM]} ${curY}</title>
    <style>
      *{box-sizing:border-box;margin:0;padding:0;}
