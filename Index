        <div style={{border:`1px solid ${C.border}`,borderRadius:"0 0 6px 6px",overflow:"hidden"}}>
          {rows.map((row,i)=>{
            const mins=calcMins(row.start,row.end,row.pause);
            const hol=row.date&&holidays[row.date];
            const we=row.date&&[0,6].includes(new Date(row.date).getDay());
            return(
              <div key={row.id} className="trow ri" style={{
                display:"grid",gridTemplateColumns:"102px 74px 74px 72px 58px 1fr 26px",
                gap:"6px",padding:"10px 12px",
                background:hol?C.rowHol:C.rowBg,
                borderBottom:`1px solid ${C.border}`,
                alignItems:"center",
                borderLeft:`2px solid ${mins!==null?C.accent:"transparent"}`,
                transition:"background 0.1s,border-left-color 0.2s",
              }}>
                <input type="date" value={row.date} onChange={e=>updateRow(i,"date",e.target.value)} style={{...inp,fontSize:"12px"}}/>
                <input type="time" value={row.start} onChange={e=>updateRow(i,"start",e.target.value)} placeholder="08:00" style
