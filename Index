      .sub{color:#999;font-size:11px;letter-spacing:2px;margin-bottom:24px;}
      .meta{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:0;border:1px solid #ddd;border-radius:6px;overflow:hidden;margin-bottom:24px;}
      .meta-cell{padding:10px 14px;border-right:1px solid #ddd;}
      .meta-cell:last-child{border-right:none;}
      .meta-label{font-size:9px;color:#aaa;letter-spacing:1.5px;margin-bottom:3px;}
      .meta-val{font-size:13px;font-weight:600;}
      table{width:100%;border-collapse:collapse;margin-bottom:20px;}
      th{background:#111;color:#fff;padding:9px 12px;text-align:left;font-size:10px;letter-spacing:1px;}
      td{padding:8px 12px;border-bottom:1px solid #eee;font-size:12px;}
      .total-box{background:#f5f5f5;border-radius:6px;padding:16px 20px;margin-bottom:32px;display:flex;justify-content:space-between;align-items:center;}
      .total-hours{font-size:32px;font-weight:900;letter-spacing:-1px;}
      .sig{display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:40px;}
      .sig-line{border-top:1px solid #bbb;padding-top:6px;font-size:10px;color:#aaa;letter-spacing:1px;}
      @media print{body{padding:20px;}}
    </style></head><body>
    <h1>STUNDENZETTEL</h1>
    <div class="sub">ARBEITSZEITERFASSUNG · ${MONTHS[curM].toUpperCase()} ${curY}</div>
    <div class="meta">
      <div class="meta-cell"><div class="meta-label">NAME</div><div class="meta-val">${profile.name||"—"}</div></div>
      <div class="meta-cell"><div class="meta-label">ARBEITGEBER</div><div class="meta-val">${profile.employer||"—"}</div></div>
      <div class="meta-cell"><div class="meta-label">BUNDESLAND</div><div class="meta-val">${blName}</div></div>
      <div class="meta-cell"><div class="meta-label">MONAT</div><div class="meta-val">${MONTHS[curM]} ${curY}</div></div>
    </div>
    <table>
      <thead><tr><th>DATUM</th><th>VON</th><th>BIS</th><th>PAUSE</th><th style="text-align:right">STUNDEN</th><th>NOTIZ / FEIERTAG</th></tr></thead>
      <tbody>${rowsHTML}<tr style="background:#f9f9f9;font-weight:700"><td colspan="4" style="text-align:right;padding-top:10px">GESAMT</td><td style="text-align:right;font-size:15px;padding-top:10px">${toHHMM(totalMins)}</td><td style="padding-top:10px">${filledRows.length} Arbeitstag(e)</td></tr>${earRow}</tbody>
    </table>
    ${over?`<div style="background:#fff0f0;border:1px solid #ffaaaa;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#cc3333;font-weight:600">⚠️ Achtung: Minijob-Grenze (${MINIJOB} €) wurde überschritten!</div>`:""}
    <div class="sig"><div class="sig-line">UNTERSCHRIFT ARBEITNEHMER</div><div class="sig-line">UNTERSCHRIFT ARBEITGEBER</div></div>
    <script>window.onload=()=>{setTimeout(()=>window.print(),300);}<\/script>
    </body></html>`);
    win.document.close();
  }

  // ── Theme ─────────────────────────────────────────────────────────────────
  const dk=theme==="dark";
  const C={
    bg:dk?"#0d0d0d":"#f2f0ec",
    card:dk?"#141414":"#ffffff",
    border:dk?"#1e1e1e":"#dedad4",
    text:dk?"#e8e0d0":"#1a1a1a",
    muted:dk?"#505050":"#888",
    accent:"#c8a96e",
    rowBg:dk?"#0f0f0f":"#fafaf8",
    rowHol:dk?"#1a1508":"#fffbf0",
    danger:"#e05555",
    success:"#5a9e6f",
  };
  const inp={background:"transparent",color:C.text,border:"none",outline:"none",fontFamily:"'DM Mono',monospace",width:"100%",fontSize:"13px"};

  return(
    <div style={{minHeight:"100vh",background:C.bg,fontFamily:"'DM Mono','Courier New',monospace",color:C.text,transition:"background 0.2s,color 0.2s"}}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@700;800&display=swap');
        *{box-sizing:border-box;margin:0;padding:0;}
        input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;}
        input[type=date],input[type=time]{color-scheme:${dk?"dark":"light"};}
        input::placeholder{color:${C.muted};}
        select option{background:${dk?"#1a1a1a":"#fff"};color:${C.text};}
        .btn{cursor:pointer;border:none;transition:all 0.15s;}
        .btn:hover{opacity:0.82;}
        .trow:hover{background:${dk?"#161616":"#f5f2ee"} !important;}
        .ri{animation:ri 0.15s ease;}
        @keyframes ri{from{opacity:0;transform:translateY(-3px)}to{opacity:1}}
        ::-webkit-scrollbar{width:4px;}
        ::-webkit-scrollbar-thumb{background:${C.border};}
        select{background:transparent;color:${C.text};border:none;outline:none;font-family:'DM Mono',monospace;font-size:12px;width:100%;}
      `}</style>

      {/* ── HEADER ── */}
      <div style={{borderBottom:`1px solid ${C.border}`,padding:"18px 24px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:"12px",flexWrap:"wrap"}}>
        <div>
          <div style={{fontFamily:"'Syne',sans-serif",fontSize:"clamp(18px,4vw,26px)",fontWeight:800,letterSpacing:"-0.5px",lineHeight:1}}>STUNDENZETTEL</div>
          <div style={{fontSize:"9px",color:C.muted,marginTop:"3px",letterSpacing:"2px"}}>ARBEITSZEITERFASSUNG · DEUTSCHLAND</div>
        </div>
        <div style={{display:"flex",gap:"8px",alignItems:"center"}}>
          <button className="btn" onClick={()=>setTheme(t=>t==="dark"?"light":"dark")}
            style={{background:C.card,border:`1px solid ${C.border}`,color:C.text,padding:"8px 12px",borderRadius:"6px",fontSize:"14px"}}>
            {dk?"☀️":"🌙"}
          </button>
          <button className="btn" onClick={()=>setShowHelp(true)}
            title="Hilfe / Anleitung"
            style={{background:C.accent,color:"#0d0d0d",width:"36px",height:"36px",borderRadius:"50%",fontWeight:700,fontSize:"15px",fontFamily:"'Syne',sans-serif",flexShrink:0}}>
            ?
          </button>
        </div>
      </div>

      <div style={{padding:"20px 24px",maxWidth:"960px",margin:"0 auto"}}>

        {/* ── PROFILE ── */}
        <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(150px,1fr))",gap:"12px",marginBottom:"20px",padding:"16px 18px",background:C.card,borderRadius:"8px",border:`1px solid ${C.border}`}}>
          {[
            {label:"Name",k:"name",ph:"Dein Name"},
            {label:"Arbeitgeber",k:"employer",ph:"Firma / Person"},
            {label:"Stundenlohn (€)",k:"hourlyRate",ph:"z.B. 12.82",tp:"number"},
          ].map(f=>(
            <div key={f.k} style={{borderBottom:`1px solid ${C.border}`,paddingBottom:"6px"}}>
              <div style={{fontSize:"9px",color:C.muted,letterSpacing:"1.5px",marginBottom:"3px"}}>{f.label.toUpperCase()}</div>
              <input type={f.tp||"text"} value={profile[f.k]}
                onChange={e=>setProfile(p=>({...p,[f.k]:e.target.value}))}
                placeholder={f.ph} style={inp} />
            </div>
          ))}
          <div style={{borderBottom:`1px solid ${C.border}`,paddingBottom:"6px"}}>
            <div style={{fontSize:"9px",color:C.muted,letterSpacing:"1.5px",marginBottom:"3px"}}>BUNDESLAND</div>
            <select value={profile.bundesland} onChange={e=>setProfile(p=>({...p,bundesland:e.target.value}))}>
              {BL_LIST.map(b=><option key={b.code} value={b.code}>{b.name}</option>)}
            </select>
          </div>
