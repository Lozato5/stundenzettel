          <div style={{marginBottom:"16px",padding:"14px 16px",background:C.card,border:`1px solid ${over?C.danger:C.border}`,borderRadius:"8px",transition:"border-color 0.2s"}}>
            <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:"8px",fontSize:"12px"}}>
              <span style={{color:C.muted}}>💰 Minijob-Status</span>
              <span style={{color:over?C.danger:C.accent,fontWeight:600}}>
                {over
                  ?`⚠️ ${(earnings-MINIJOB).toFixed(2).replace(".",",")} € über der Grenze!`
                  :`${earnings.toFixed(2).replace(".",",")} € / ${MINIJOB} €`}
              </span>
            </div>
            <div style={{height:"6px",background:C.border,borderRadius:"3px",overflow:"hidden"}}>
              <div style={{height:"100%",width:`${pct}%`,background:over?C.danger:C.accent,borderRadius:"3px",transition:"width 0.4s ease"}}/>
            </div>
            <div style={{fontSize:"11px",color:C.muted,marginTop:"6px"}}>
              {over
                ?`Grenze überschritten – beim Arbeitgeber klären!`
                :`Noch ${(MINIJOB-earnings).toFixed(2).replace(".",",")} € bis zur Minijob-Grenze (${MINIJOB} €)`}
            </div>
          </div>
        )}

        {/* ── TABLE HEADER ── */}
        <div style={{display:"grid",gridTemplateColumns:"102px 74px 74px 72px 58px 1fr 26px",gap:"6px",padding:"8px 12px",background:C.card,borderRadius:"6px 6px 0 0",fontSize:"9px",color:C.muted,letterSpacing:"1.5px",border:`1px solid ${C.border}`,borderBottom:"none"}}>
          <span>DATUM</span><span>VON</span><span>BIS</span><span>PAUSE</span><span>STD</span><span>NOTIZ</span><span/>
        </div>

