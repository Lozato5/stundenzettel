        {/* ── MONTH NAV ── */}
        <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"16px"}}>
          <button className="btn" onClick={prevM} style={{background:C.card,border:`1px solid ${C.border}`,color:C.text,padding:"8px 18px",borderRadius:"6px",fontSize:"20px",lineHeight:1}}>‹</button>
          <div style={{textAlign:"center"}}>
            <div style={{fontFamily:"'Syne',sans-serif",fontSize:"22px",fontWeight:800,lineHeight:1}}>{MONTHS[curM]}</div>
            <div style={{fontSize:"12px",color:C.muted,marginTop:"2px"}}>{curY}</div>
          </div>
          <button className="btn" onClick={nextM} style={{background:C.card,border:`1px solid ${C.border}`,color:C.text,padding:"8px 18px",borderRadius:"6px",fontSize:"20px",lineHeight:1}}>›</button>
